{
  "expo": {
    "name": "Glow",
    "slug": "glow-lash",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "glow",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FAF7F2"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glowlashstudio.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.glowlashstudio.app",
      "adaptiveIcon": {
        "backgroundColor": "#2B2521"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C9A96A",
          "defaultChannel": "appointments"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
